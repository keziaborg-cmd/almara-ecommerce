# Copy to .env.local (gitignored) and fill in real values. Never commit this file with real values.

# Supabase — same project used by the Smartea+ (Expo) app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mercado Pago Public Key — safe to expose client-side, used to init the Payment Brick.
# The Access Token stays server-side only, as the MERCADOPAGO_ACCESS_TOKEN Edge Function secret
# already set on the linked Supabase project (reused from the app's existing MP integration).
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Tracking
# GA4 tem default G-PV98V0QPPC no código (components/providers/tracking-scripts.tsx); preencha só para sobrescrever.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Contact / WhatsApp CTA (wa.me link, no number formatting beyond digits)
# Default 5519990306995 no código (lib/whatsapp/link.ts); preencha só para sobrescrever.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Padrão no código: almaramais (https://www.instagram.com/almaramais/); preencha só para sobrescrever.
NEXT_PUBLIC_INSTAGRAM_HANDLE=
# Padrão no código: ola@almara.com.br; preencha só para sobrescrever.
NEXT_PUBLIC_CONTACT_EMAIL=

# Endereço público do site (metadataBase, canonical, sitemap, robots, JSON-LD). Padrão: https://almara.com.br
NEXT_PUBLIC_SITE_URL=

# Liga o redirect 301 de smartea.com.br (e www) pro NEXT_PUBLIC_SITE_URL. Só depois que o domínio novo
# estiver no ar com HTTPS. Vazio/0 = desligado.
REDIRECT_LEGACY_DOMAIN=
